{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin-backend": {
      "root": "admin-backend",
      "framework": "express"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "bindings": [
        {
          "type": "service",
          "service": "admin-backend",
          "format": "url",
          "env": "ADMIN_BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "backend"
      }
    }
  ]
}
